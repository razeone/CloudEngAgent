{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cloudeng-agent://widgets/approval-card.schema.json",
  "title": "approval-card",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "payloadPreview", "inputRequestId", "options"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "payloadPreview": { "type": "string" },
    "inputRequestId": { "type": "string", "format": "uuid" },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
