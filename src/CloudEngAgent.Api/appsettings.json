{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Entra": {
    "TenantId": "",
    "Audience": "api://cloud-eng-agent"
  },
  "KeyVault": {
    "Uri": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Runs": {
    "MaxConcurrent": 32,
    "EventBufferSize": 1024
  },
  "Sse": {
    "TokenLifetimeSeconds": 120
  },
  "Backends": {
    "azure-openai":   { "Endpoint": "", "Deployment": "gpt-4o", "AuthMode": "ManagedIdentity" },
    "azure-foundry":  { "Endpoint": "", "Model": "", "ApiKeyRef": "foundry-key" },
    "anthropic":      { "Model": "claude-opus-4-7", "ApiKeyRef": "anthropic-key" },
    "github-models":  { "Model": "gpt-4o", "ApiKeyRef": "github-pat" },
    "openai":         { "Model": "gpt-4o", "ApiKeyRef": "openai-key" }
  },
  "Mcp": {
    "Servers": [
      { "Name": "cloudeng-db", "Transport": "http", "Url": "http://localhost:5010/mcp" }
    ]
  },
  "Personas": {
    "Path": "./personas"
  },
  "ConnectionStrings": {
    "Runs": ""
  }
}
